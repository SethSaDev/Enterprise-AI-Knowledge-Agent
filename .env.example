# Application
NODE_ENV=development
PORT=3000
WS_PORT=3001
APP_NAME=Knowledge Agent Platform

# Database
DATABASE_URL=postgresql://admin:change_me@localhost:5432/knowledge_agent?schema=public
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0

# JWT
JWT_SECRET=super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-documents

# Rate Limiting
RATE_LIMIT_OPENAI_PER_MINUTE=60
RATE_LIMIT_ANTHROPIC_PER_MINUTE=60
RATE_LIMIT_GLOBAL_PER_MINUTE=1000

# Budget Limits (tokens per month)
BUDGET_MONTHLY_LIMIT_FREE=100000
BUDGET_MONTHLY_LIMIT_PRO=1000000
BUDGET_MONTHLY_LIMIT_BUSINESS=10000000
BUDGET_MONTHLY_LIMIT_ENTERPRISE=100000000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Email (for production)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@knowledge-agent.com

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info

# Security
CORS_ORIGINS=http://localhost:3002,https://yourdomain.com
CSRF_SECRET=csrf-secret-key-change-me
SESSION_SECRET=session-secret-key-change-me

# Feature Flags
ENABLE_OAUTH_GOOGLE=false
ENABLE_OAUTH_GITHUB=false
ENABLE_WORKFLOWS=true
ENABLE_ANALYTICS=true
ENABLE_AUDIT_LOGS=true